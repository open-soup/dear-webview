# git extras by: @nobodynose
# credits to @boblescripter @pithoniko
# git by linus torvalds

;gitspecs
{gitignoreindexers}
[
@fastindexing
!retrygitignoresearch=false
!searchongpu=false # set this to false if your on a laptop without a gpu or just dont have one
]

{autopush}
[
%pushtimer=false
%pushaftercommand="git commit"
]

{filerot}
[
!enablefilerot=true
%timer=2592000
]
